    <!-- Hero Section -->
    <section id="inicio" class="pt-28 pb-20 md:pt-40 md:pb-32 hero-pattern">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-gray-900 mb-6">
                Construindo um Futuro <br class="hidden md:block" />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-cyan-500">Transparente e Inclusivo</span>
            </h1>
            <p class="mt-4 max-w-2xl text-lg md:text-xl text-gray-600 mx-auto mb-10">
                Uma iniciativa dedicada a promover políticas públicas eficientes, participação cidadã e desenvolvimento sustentável para nossa comunidade. Conheça nossas propostas e quem está por trás deste movimento.
            </p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="#politicas" class="px-8 py-3 md:py-4 md:px-10 border border-transparent text-base md:text-lg font-medium rounded-full text-white bg-blue-700 hover:bg-blue-800 shadow-lg hover:shadow-xl transition-all duration-300">
                    Conhecer as Políticas
                </a>
