        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
                <!-- Brand Info -->
                <div>
                    <div class="flex items-center gap-2 mb-6">
                        <i class="fa-solid fa-building-columns text-3xl text-blue-400"></i>
                        <span class="text-2xl font-bold">Projeto Avante</span>
                    </div>
                    <p class="text-gray-400 leading-relaxed mb-6">
                        Nosso compromisso é com o avanço social, econômico e ambiental, construindo pontes entre a gestão pública e as necessidades da população.
                    </p>
                </div>

                <!-- Contatos -->
                <div>
                    <h4 class="text-lg font-bold mb-6 border-b border-gray-700 pb-2">Informações de Contato</h4>
                    <ul class="space-y-4 text-gray-400">
                        <li class="flex items-start gap-3">
                            <i class="fa-solid fa-location-dot mt-1 text-blue-400"></i>
                            <span>Av. Cidadania, 1000 - Centro<br>Brasília - DF, 70000-000</span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-envelope text-blue-400"></i>
                            <a href="mailto:contato@projetoavante.gov" class="hover:text-white transition">contato@projetoavante.gov</a>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="fa-solid fa-phone text-blue-400"></i>
                            <span>(11) 99999-9999</span>
                        </li>
                    </ul>
                </div>

                <!-- Links e Social -->
                <div>
                    <h4 class="text-lg font-bold mb-6 border-b border-gray-700 pb-2">Acesso Rápido</h4>
                    <ul class="space-y-3 text-gray-400 mb-8">
                        <li><a href="#inicio" class="hover:text-white transition">Portal do Início</a></li>
                        <li><a href="#politicas" class="hover:text-white transition">Nossas Políticas</a></li>
                        <li><a href="#liderancas" class="hover:text-white transition">Corpo de Lideranças</a></li>
                    </ul>
                    
                    <h4 class="text-sm font-bold uppercase tracking-wider mb-4">Siga-nos</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:text-white transition duration-300">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-purple-600 hover:text-white transition duration-300">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="#" class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center text-gray-400 hover:bg-blue-400 hover:text-white transition duration-300">
