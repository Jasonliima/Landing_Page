                <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
                    Conheça a equipe dedicada de especialistas e representantes que coordenam o planejamento e a execução do nosso projeto.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
                <!-- Leader 1 -->
                <div class="bg-white rounded-3xl p-6 text-center shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                    <img src="https://placehold.co/400x400/1e3a8a/ffffff?text=CF" alt="Carlos Ferraz" class="w-32 h-32 rounded-full mx-auto mb-6 object-cover border-4 border-blue-50 shadow-sm">
