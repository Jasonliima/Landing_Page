    <!-- Políticas Adotadas Section -->
    <section id="politicas" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-blue-600 font-semibold uppercase tracking-wider text-sm">Diretrizes Principais</span>
                <h2 class="mt-2 text-3xl md:text-4xl font-bold text-gray-900">Políticas Adotadas</h2>
                <div class="mt-4 w-24 h-1 bg-blue-600 mx-auto rounded-full"></div>
                <p class="mt-4 text-gray-600 max-w-2xl mx-auto">
                    Nossos pilares de atuação visam garantir a melhoria contínua dos serviços públicos e a qualidade de vida da população.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Policy Card 1 -->
                <div class="bg-gray-50 rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fa-solid fa-magnifying-glass text-8xl text-blue-900"></i>
                    </div>
                    <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center text-blue-700 text-2xl mb-6 relative z-10">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3 relative z-10">Transparência Total</h3>
                    <p class="text-gray-600 relative z-10 leading-relaxed">
                        Compromisso com a abertura de dados governamentais, permitindo que qualquer cidadão acompanhe os gastos públicos e os processos decisórios em tempo real.
                    </p>
                </div>

                <!-- Policy Card 2 -->
                <div class="bg-gray-50 rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fa-solid fa-leaf text-8xl text-green-900"></i>
                    </div>
                    <div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center text-green-700 text-2xl mb-6 relative z-10">
                        <i class="fa-solid fa-seedling"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3 relative z-10">Desenvolvimento Sustentável</h3>
                    <p class="text-gray-600 relative z-10 leading-relaxed">
                        Implementação de projetos focados em energia limpa, mobilidade urbana verde e incentivos fiscais para empresas com práticas ESG comprovadas.
                    </p>
                </div>

                <!-- Policy Card 3 -->
                <div class="bg-gray-50 rounded-2xl p-8 shadow-sm hover:shadow-xl transition-shadow duration-300 border border-gray-100 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                        <i class="fa-solid fa-book-open text-8xl text-orange-900"></i>
                    </div>
                    <div class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center text-orange-700 text-2xl mb-6 relative z-10">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-3 relative z-10">Educação Inclusiva</h3>
                    <p class="text-gray-600 relative z-10 leading-relaxed">
                        Modernização da infraestrutura escolar e programas de capacitação tecnológica voltados para jovens de áreas em vulnerabilidade social.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Lideranças Section -->
    <section id="liderancas" class="py-20 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
