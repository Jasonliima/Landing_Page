                <a href="#politicas" class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-700 hover:bg-gray-50 rounded-md">Políticas Adotadas</a>
                <a href="#liderancas" class="block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-700 hover:bg-gray-50 rounded-md">Lideranças</a>
